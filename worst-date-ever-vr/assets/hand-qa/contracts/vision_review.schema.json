{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worst Date Ever visual and hand-contact evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "candidate_hash", "evidence", "scores", "defects", "missing_evidence", "decision", "next_actions"],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "candidate_hash": {"type": "string", "minLength": 1},
    "source_url": {"type": ["string", "null"]},
    "license_check": {"enum": ["NOT_CHECKED", "CHECKED_BY_HUMAN", "INVALID", "UNKNOWN"]},
    "engine": {"type": "string"},
    "vision_model": {"type": "string"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "capture_type", "angle", "hand", "input_mode", "is_reviewable"],
        "properties": {
          "filename": {"type": "string", "minLength": 1},
          "capture_type": {"enum": ["model", "engine_closeup", "mechanical_state", "held", "hand_action", "mesh_wireframe", "collider", "video_frame"]},
          "angle": {"type": "string"},
          "hand": {"enum": ["left", "right", "both", "none"]},
          "input_mode": {"enum": ["synthetic", "quest_controller", "quest_tracked_hand", "not_applicable"]},
          "is_reviewable": {"type": "boolean"}
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["silhouette", "materials", "detail", "vr_readability", "visible_integrity"],
      "properties": {
        "silhouette": {"$ref": "#/$defs/grade"},
        "materials": {"$ref": "#/$defs/grade"},
        "detail": {"$ref": "#/$defs/grade"},
        "vr_readability": {"$ref": "#/$defs/grade"},
        "visible_integrity": {"$ref": "#/$defs/grade"},
        "grip_alignment": {"$ref": "#/$defs/maybeGrade"},
        "finger_contact": {"$ref": "#/$defs/maybeGrade"},
        "handedness": {"$ref": "#/$defs/maybeGrade"},
        "pose_stability": {"$ref": "#/$defs/maybeGrade"},
        "functional_states": {"$ref": "#/$defs/maybeGrade"}
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "region", "severity", "defect", "fix"],
        "properties": {
          "image": {"type": "string"},
          "region": {"type": "string"},
          "severity": {"enum": ["minor", "major", "blocking"]},
          "defect": {"type": "string", "minLength": 1},
          "fix": {"type": "string", "minLength": 1}
        }
      }
    },
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "not_applicable_views": {
      "type": "array",
      "items": {"type": "object", "required": ["view", "reason"], "properties": {"view": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}
    },
    "decision": {"enum": ["REJECT", "REWORK", "MISSING_EVIDENCE", "VISION_PASS_PENDING_HUMAN", "APPROVED_BY_HUMAN"]},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "human_reviewer": {"type": ["string", "null"]},
    "quest_runtime_test": {"enum": ["NOT_TESTED", "PASSED", "FAILED"]}
  },
  "$defs": {
    "grade": {"type": "integer", "minimum": 1, "maximum": 5},
    "maybeGrade": {"oneOf": [{"$ref": "#/$defs/grade"}, {"type": "null"}]}
  }
}
