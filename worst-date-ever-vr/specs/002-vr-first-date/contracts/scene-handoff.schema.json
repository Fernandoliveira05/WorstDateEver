{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FirstDateSceneHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "avatarGender",
    "preference",
    "matchId",
    "substance"
  ],
  "properties": {
    "candy": {
      "enum": [null, "pacoca", "tamarindo", "morango", "hortela"]
    },
    "schemaVersion": {
      "const": 1
    },
    "phase": {
      "const": "exit"
    },
    "avatarGender": {
      "enum": [
        "male",
        "female"
      ]
    },
    "preference": {
      "enum": [
        "men",
        "women",
        "all"
      ]
    },
    "matchId": {
      "enum": [
        "caio",
        "rafa",
        "bia",
        "luiza"
      ]
    },
    "substance": {
      "enum": [
        "none",
        "weed",
        "lsd",
        "alcohol"
      ]
    },
    "profileIndex": {
      "type": "integer",
      "minimum": 0
    }
  }
}
