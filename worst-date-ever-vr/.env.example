# Vite proxies /v1 to the local date service by default. Set this only when the
# browser must reach a separately hosted HTTPS service (for example, on Quest).
# VITE_DATE_VOICE_URL=https://voice.example.com/

# Date service network settings.
DATE_HOST=127.0.0.1
DATE_PORT=8787
DATE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://canon-neuter-venture.ngrok-free.dev

# Simplest setup: Gemini handles both transcription and NPC dialogue.
# Keep this key server-side. Never prefix it with VITE_.
GEMINI_API_KEY=replace-with-your-server-api-key
DATE_GEMINI_STT_MODEL=gemini-3.5-transcribe
DATE_GEMINI_DIALOGUE_MODEL=gemini-3.8-flash

# Optional alternatives. Leave unset when using Gemini above.
# OPENAI_API_KEY=replace-with-your-server-api-key
# DATE_STT_MODEL=gpt-4o-mini-transcribe
# DATE_DIALOGUE_MODEL=gpt-6.2-sol
# DATE_WHISPER_URL=http://127.0.0.1:8788
# DEEPSEEK_API_KEY=replace-with-your-server-api-key
# DATE_DEEPSEEK_MODEL=deepseek-flash
# DATE_GEMMA_URL=http://127.0.0.1:8080
# DATE_GEMMA_MODEL=gemma-3-1b-it

# Optional local text-to-speech service. Without it, browser speech synthesis
# remains the fallback for NPC lines.
# DATE_TTS_URL=http://127.0.0.1:8784
